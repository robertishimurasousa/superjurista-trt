{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/unmatched-remedy-review.v1.schema.json",
  "title": "Registro protegido de conferência de itens sem associação v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_pdf_sha256", "evidence_sha256",
    "blind_inventory_sha256", "reviewer_name", "reviewed_at",
    "blind_inventory_frozen", "original_pdf_checked",
    "authorizes_external_action", "items"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "source_pdf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "blind_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_name": {"type": "string", "maxLength": 200},
    "reviewed_at": {
      "type": "string",
      "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "blind_inventory_frozen": {"type": "boolean"},
    "original_pdf_checked": {"type": "boolean"},
    "authorizes_external_action": {"type": "boolean", "const": false},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "request_id", "source_document_id", "source_locator",
          "text_sha256", "decision", "reason"
        ],
        "properties": {
          "request_id": {"type": "string", "pattern": "^[A-Z]$"},
          "source_document_id": {"type": "string", "pattern": "^DOC-[0-9]{3,}$"},
          "source_locator": {"type": "string", "pattern": "^página [0-9]+, pedido [A-Z]$"},
          "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "decision": {
            "type": "string",
            "enum": ["pending", "non_material", "material_claim", "unable_to_assess"]
          },
          "reason": {"type": "string", "maxLength": 4000}
        }
      }
    }
  }
}
