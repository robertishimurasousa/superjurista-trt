{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/evidence-inventory-review.v1.schema.json",
  "title": "Registro protegido de revisão do inventário probatório v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_pdf_sha256", "inventory_index_sha256",
    "reviewer_name", "reviewed_at", "documents", "items"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
    "inventory_index_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer_name": {"type": "string", "maxLength": 200},
    "reviewed_at": {
      "type": "string",
      "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id", "page_start", "page_end", "inventory_status",
          "coverage_status", "inventory_limitations", "all_pages_reviewed",
          "missing_item_note", "notes"
        ],
        "properties": {
          "document_id": {"type": "string", "pattern": "^DOC-[0-9]{3,}$"},
          "page_start": {"type": "integer", "minimum": 1},
          "page_end": {"type": "integer", "minimum": 1},
          "inventory_status": {"type": "string", "enum": ["pending_human_review", "insufficient"]},
          "coverage_status": {"type": "string", "enum": ["items_identified", "no_item_identified"]},
          "inventory_limitations": {"type": "array", "items": {"type": "string"}},
          "all_pages_reviewed": {"type": "boolean"},
          "missing_item_note": {"type": "string", "maxLength": 4000},
          "notes": {"type": "string", "maxLength": 4000}
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id", "source_document_id", "pdf_page", "excerpt", "source_type",
          "description", "source_limitations", "proposed_claim_ids", "decision",
          "selected_type", "selected_claim_ids", "relation", "proposition", "reason", "limitations"
        ],
        "properties": {
          "item_id": {"type": "string", "pattern": "^INV-DOC-[0-9]{3,}-[0-9]{3,}$"},
          "source_document_id": {"type": "string", "pattern": "^DOC-[0-9]{3,}$"},
          "pdf_page": {"type": "integer", "minimum": 1},
          "excerpt": {"type": "string", "minLength": 1},
          "source_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "description": {"type": "string", "minLength": 1},
          "source_limitations": {"type": "array", "items": {"type": "string"}},
          "proposed_claim_ids": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "pattern": "^CLM-[0-9]{3,}$"}
          },
          "decision": {"type": "string", "enum": ["pending", "include", "exclude", "defer"]},
          "selected_type": {"type": "string", "pattern": "^$|^[a-z][a-z0-9_]*$"},
          "selected_claim_ids": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "pattern": "^CLM-[0-9]{3,}$"}
          },
          "relation": {
            "type": "string", "enum": ["", "supports_claim", "opposes_claim", "neutral_context"]
          },
          "proposition": {"type": "string", "maxLength": 4000},
          "reason": {"type": "string", "maxLength": 4000},
          "limitations": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 1000}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
