{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/openai-api-authorization.v1.schema.json",
  "title": "Autorização específica da API da OpenAI para o piloto TRT12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "surface",
    "pilot_id",
    "case_reference_digest",
    "authorization_scope_digest",
    "access_classification",
    "model_id",
    "authorized_by",
    "approved_at",
    "valid_until",
    "provider_terms_digest",
    "provider_terms_reviewed_by",
    "request_controls"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "provider": {"type": "string", "const": "openai_api"},
    "surface": {"type": "string", "const": "responses"},
    "pilot_id": {"type": "string", "pattern": "^PILOT-[A-Z0-9_-]{3,32}$"},
    "case_reference_digest": {"$ref": "#/$defs/sha256"},
    "authorization_scope_digest": {"$ref": "#/$defs/sha256"},
    "access_classification": {
      "type": "string",
      "enum": ["public_or_authorized", "restricted_authorized"]
    },
    "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"},
    "authorized_by": {"$ref": "#/$defs/actor_id"},
    "approved_at": {"$ref": "#/$defs/timestamp"},
    "valid_until": {"$ref": "#/$defs/timestamp"},
    "provider_terms_digest": {"$ref": "#/$defs/sha256"},
    "provider_terms_reviewed_by": {"$ref": "#/$defs/actor_id"},
    "request_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools_allowed", "response_storage_allowed", "external_actions_allowed"
      ],
      "properties": {
        "tools_allowed": {"type": "boolean", "const": false},
        "response_storage_allowed": {"type": "boolean", "const": false},
        "external_actions_allowed": {"type": "boolean", "const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actor_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
