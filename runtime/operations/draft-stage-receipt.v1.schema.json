{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/draft-stage-receipt.v1.schema.json",
  "title": "Recibo do despacho sintético da minuta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "execution_mode", "model_id", "agent_sha256",
    "fixture_sha256", "source_pdf_sha256", "source_register_sha256",
    "input_sha256", "analysis_sha256", "analysis_receipt_sha256",
    "prompt_sha256", "disposition_sha256", "draft_sha256",
    "gate_status", "review_status", "finished_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "execution_mode": {"enum": ["codex_cli", "simulated"]},
    "model_id": {"type": "string", "minLength": 2},
    "agent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_pdf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_register_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_sha256": {
      "type": "object",
      "minProperties": 7,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "analysis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "analysis_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "disposition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "draft_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate_status": {"const": "passed"},
    "review_status": {"const": "pending_human_review"},
    "finished_at": {"type": "string", "format": "date-time"}
  }
}
