{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/claim-analysis-rehearsal-result.v1.schema.json",
  "title": "Resultado do ensaio sintético de análise por pedido",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_mode",
    "model_id",
    "agent_sha256",
    "fixture_sha256",
    "analysis_sha256",
    "gate_status",
    "review_status",
    "finished_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "execution_mode": {"enum": ["codex_cli", "simulated"]},
    "model_id": {"type": "string", "minLength": 2},
    "agent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "analysis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gate_status": {"const": "passed"},
    "review_status": {"const": "pending_human_review"},
    "finished_at": {"type": "string", "format": "date-time"}
  }
}
