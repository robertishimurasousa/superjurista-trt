{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/evidence-selection-provenance.v1.schema.json",
  "title": "Proveniência protegida da seleção de candidatos probatórios v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "source_pdf_sha256", "inventory_index_sha256",
    "review_sha256", "candidate_matrix_sha256", "selections", "excluded_item_ids"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "status": {"type": "string", "const": "candidate_only"},
    "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
    "inventory_index_sha256": {"$ref": "#/$defs/sha256"},
    "review_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id", "evidence_id", "source_document_id", "pdf_page",
          "excerpt", "review_reason"
        ],
        "properties": {
          "item_id": {"type": "string", "pattern": "^INV-DOC-[0-9]{3,}-[0-9]{3,}$"},
          "evidence_id": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"},
          "source_document_id": {"type": "string", "pattern": "^DOC-[0-9]{3,}$"},
          "pdf_page": {"type": "integer", "minimum": 1},
          "excerpt": {"type": "string", "minLength": 1},
          "review_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "excluded_item_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^INV-DOC-[0-9]{3,}-[0-9]{3,}$"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
