{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/inventory-rehearsal-result.v1.schema.json",
  "title": "Resumo protegido do ensaio sintético do inventário probatório v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "execution_mode", "model_id", "agent_sha256",
    "source_pdf_sha256", "document_count", "item_count",
    "no_item_identified_count", "insufficient_count", "observations_sha256",
    "finished_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "execution_mode": {"type": "string", "enum": ["codex_cli", "simulated"]},
    "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$"},
    "agent_sha256": {"$ref": "#/$defs/sha256"},
    "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
    "document_count": {"type": "integer", "minimum": 1},
    "item_count": {"type": "integer", "minimum": 1},
    "no_item_identified_count": {"type": "integer", "minimum": 0},
    "insufficient_count": {"type": "integer", "minimum": 0},
    "observations_sha256": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^DOC-[0-9]{3,}$"},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "finished_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
