{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/evidence-matrix-approval.v1.schema.json",
  "title": "Aprovação declarada da matriz de provas candidata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_matrix_sha256", "provenance_sha256",
    "source_pdf_sha256", "review_sha256", "reviewer_name", "reviewer_role",
    "approved_at", "approval_for_pipeline", "acknowledged_uncovered_claim_ids"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "candidate_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "provenance_sha256": {"$ref": "#/$defs/sha256"},
    "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
    "review_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer_name": {"type": "string", "minLength": 1},
    "reviewer_role": {"type": "string", "minLength": 1},
    "approved_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "approval_for_pipeline": {"type": "boolean", "const": true},
    "acknowledged_uncovered_claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CLM-[0-9]{3,}$"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
