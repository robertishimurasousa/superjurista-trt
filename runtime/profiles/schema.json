{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/tribunal-profile-v1.json",
  "title": "SuperJurista tribunal profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "tribunal",
    "instances",
    "providers",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "tribunal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment",
        "code",
        "region",
        "state",
        "cnj_branch_digit"
      ],
      "properties": {
        "segment": {
          "type": "string",
          "enum": [
            "labor_justice"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^TRT[1-9][0-9]?$"
        },
        "region": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "cnj_branch_digit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        }
      }
    },
    "instances": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first",
        "second"
      ],
      "properties": {
        "first": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "final_artifact",
            "signatures"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "final_artifact": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "signatures": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "second": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "final_artifact",
            "signatures"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "final_artifact": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "signatures": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_system",
        "research"
      ],
      "properties": {
        "case_system": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "first_instance_adapter",
            "second_instance_adapter"
          ],
          "properties": {
            "type": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "first_instance_adapter": {
              "type": [
                "string",
                "null"
              ]
            },
            "second_instance_adapter": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "research": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "scope",
              "adapter",
              "enabled"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "national",
                  "regional"
                ]
              },
              "adapter": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "enabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_external_filing",
        "allow_external_signing",
        "allow_external_publication",
        "require_human_review",
        "require_verbatim_custody",
        "sealed_case_mode"
      ],
      "properties": {
        "allow_external_filing": {
          "type": "boolean"
        },
        "allow_external_signing": {
          "type": "boolean"
        },
        "allow_external_publication": {
          "type": "boolean"
        },
        "require_human_review": {
          "type": "boolean"
        },
        "require_verbatim_custody": {
          "type": "boolean"
        },
        "sealed_case_mode": {
          "type": "string",
          "enum": [
            "deny_until_configured"
          ]
        }
      }
    }
  }
}
