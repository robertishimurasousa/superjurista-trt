{
  "schema_version": 1,
  "required_classifications": [
    "authentication",
    "task_listing",
    "process_discovery",
    "document_index",
    "document_download"
  ],
  "authentication_header_names_any": [
    "authorization",
    "x-pje-cookies"
  ],
  "authentication_cookie_names_any": [
    "JSESSIONID",
    "KEYCLOAK_IDENTITY",
    "KEYCLOAK_SESSION"
  ],
  "required_failure_groups": {
    "authentication_failure": [
      "forbidden",
      "unauthorized"
    ],
    "provider_failure": [
      "provider_error",
      "provider_timeout",
      "provider_unavailable"
    ]
  }
}
