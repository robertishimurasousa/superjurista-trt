{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/pje-recovery-state.v1.schema.json",
  "title": "PJe recovery state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case",
    "authorization_scope_digest",
    "selection_mode",
    "requested_document_ids",
    "max_attempts",
    "catalog_digest",
    "status",
    "acquisition_cycles",
    "successful_documents",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_number", "tribunal_code", "instance"],
      "properties": {
        "case_number": {
          "type": "string",
          "pattern": "^[0-9]{7}-[0-9]{2}\\.[0-9]{4}\\.5\\.[0-9]{2}\\.[0-9]{4}$"
        },
        "tribunal_code": {
          "type": "string",
          "pattern": "^TRT[1-9][0-9]?$"
        },
        "instance": {
          "type": "integer",
          "enum": [1, 2]
        }
      }
    },
    "authorization_scope_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selection_mode": {
      "type": "string",
      "enum": ["all", "explicit"]
    },
    "requested_document_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^DOC-[0-9]{3,}$"
      }
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": ["in_progress", "complete", "exhausted"]
    },
    "acquisition_cycles": {
      "type": "integer",
      "minimum": 1
    },
    "successful_documents": {
      "type": "integer",
      "minimum": 0
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "sha256",
          "attempt_count",
          "status",
          "relative_path",
          "byte_count",
          "last_error"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^DOC-[0-9]{3,}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "attempt_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "status": {
            "type": "string",
            "enum": ["pending", "accepted", "exhausted"]
          },
          "relative_path": {
            "type": ["string", "null"]
          },
          "byte_count": {
            "type": "integer",
            "minimum": 0
          },
          "last_error": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
