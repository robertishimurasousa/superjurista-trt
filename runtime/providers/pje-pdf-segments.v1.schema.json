{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/pje-pdf-segments.v1.schema.json",
  "title": "PJe consolidated PDF segments v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "segmentation_method",
    "source_pdf",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "segmentation_method": {
      "type": "string",
      "const": "pje_pdf_outline"
    },
    "source_pdf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "page_count"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "provider_reference",
          "provider_type",
          "filed_on",
          "page_start",
          "page_end"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^DOC-[0-9]{3,}$"
          },
          "provider_reference": {
            "type": "string",
            "pattern": "^[0-9a-f]{7}$"
          },
          "provider_type": {
            "type": "string",
            "minLength": 1
          },
          "filed_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "page_start": {
            "type": "integer",
            "minimum": 1
          },
          "page_end": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
