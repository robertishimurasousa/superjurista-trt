{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/decision-congruence-report.v1.schema.json",
  "title": "Decision congruence report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "claim_count",
    "coverage",
    "links"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "status": {
      "type": "string",
      "const": "passed"
    },
    "claim_count": {
      "type": "integer",
      "minimum": 1
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis",
        "disposition",
        "draft"
      ],
      "properties": {
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "covered",
            "total",
            "percent"
          ],
          "properties": {
            "covered": {
              "type": "integer",
              "minimum": 1
            },
            "total": {
              "type": "integer",
              "minimum": 1
            },
            "percent": {
              "type": "integer",
              "const": 100
            }
          }
        },
        "disposition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "covered",
            "total",
            "percent"
          ],
          "properties": {
            "covered": {
              "type": "integer",
              "minimum": 1
            },
            "total": {
              "type": "integer",
              "minimum": 1
            },
            "percent": {
              "type": "integer",
              "const": 100
            }
          }
        },
        "draft": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "covered",
            "total",
            "percent"
          ],
          "properties": {
            "covered": {
              "type": "integer",
              "minimum": 1
            },
            "total": {
              "type": "integer",
              "minimum": 1
            },
            "percent": {
              "type": "integer",
              "const": 100
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "analysis_id",
          "disposition_id",
          "outcome"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^CLM-[0-9]{3,}$"
          },
          "analysis_id": {
            "type": "string",
            "pattern": "^ANL-[0-9]{3,}$"
          },
          "disposition_id": {
            "type": "string",
            "pattern": "^DSP-[0-9]{3,}$"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "granted",
              "denied",
              "granted_in_part",
              "dismissed_without_merits",
              "procedural_resolution",
              "pending_human_review",
              "abstained"
            ]
          }
        }
      }
    }
  }
}
