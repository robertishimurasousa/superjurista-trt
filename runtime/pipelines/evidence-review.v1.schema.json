{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/evidence-review.v1.schema.json",
  "title": "Custódia da revisão probatória por pedido v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviews"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "status", "evidence_ids", "assessment", "limitations"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{3,}$"},
          "status": {
            "type": "string",
            "enum": ["not_required", "pending_human_review", "reviewed", "insufficient"]
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"}
          },
          "assessment": {"type": "string"},
          "limitations": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
