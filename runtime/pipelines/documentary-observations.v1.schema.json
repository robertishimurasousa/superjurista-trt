{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/documentary-observations.v1.schema.json",
  "title": "Observações documentais por pedido v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "source_packet_sha256", "status", "observations"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{3,}$"},
    "source_packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"type": "string", "enum": ["pending_human_review", "insufficient"]},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "source_document_id", "excerpts", "observation", "limitations"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"},
          "source_document_id": {"type": "string", "pattern": "^DOC-[0-9]{3,}$"},
          "excerpts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pdf_page", "text"],
              "properties": {
                "pdf_page": {"type": "integer", "minimum": 1},
                "text": {"type": "string", "minLength": 1, "maxLength": 2000}
              }
            }
          },
          "observation": {"type": "string", "minLength": 1, "maxLength": 4000},
          "limitations": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 1000}
          }
        }
      }
    }
  }
}
