{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/documentary-source-register.v1.schema.json",
  "title": "Registro privado de custódia documental por pedido v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id", "source_pdf_name", "source_pdf_sha256",
          "source_packet_sha256", "observations_sha256", "evidence_ids",
          "segments", "observations"
        ],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{3,}$"},
          "source_pdf_name": {"type": "string", "minLength": 1},
          "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
          "source_packet_sha256": {"$ref": "#/$defs/sha256"},
          "observations_sha256": {"$ref": "#/$defs/sha256"},
          "evidence_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^EVD-[0-9]{3,}$"}
          },
          "segments": {"type": "object"},
          "observations": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
