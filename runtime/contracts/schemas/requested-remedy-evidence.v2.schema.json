{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/requested-remedy-evidence.v2.schema.json",
  "title": "Evidência das providências requeridas v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source_pdf_sha256", "entries",
    "unmatched_item_ids", "unmatched_items"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "source_pdf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "unmatched_item_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z]$"}
    },
    "unmatched_items": {"type": "array", "items": {"$ref": "#/$defs/unmatched"}}
  },
  "$defs": {
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": [
        "request_id", "claim_id", "remedy_codes", "source_document_id",
        "source_locator", "text", "review_gaps"
      ],
      "properties": {
        "request_id": {"type": "string", "pattern": "^[A-Z](\\.[0-9]+)?$"},
        "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{3,}$"},
        "remedy_codes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "source_document_id": {"type": "string", "pattern": "^DOC-[0-9]{3,}$"},
        "source_locator": {"type": "string", "pattern": "^página [0-9]+, pedido [A-Z](\\.[0-9]+)?$"},
        "text": {"type": "string", "minLength": 1},
        "review_gaps": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "enum": ["conditional_alternative"]}
        }
      }
    },
    "unmatched": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "source_document_id", "source_locator", "text"],
      "properties": {
        "request_id": {"type": "string", "pattern": "^[A-Z]$"},
        "source_document_id": {"type": "string", "pattern": "^DOC-[0-9]{3,}$"},
        "source_locator": {"type": "string", "pattern": "^página [0-9]+, pedido [A-Z]$"},
        "text": {"type": "string", "minLength": 1}
      }
    }
  }
}
