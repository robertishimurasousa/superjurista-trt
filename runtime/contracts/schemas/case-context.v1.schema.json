{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/case-context.v1.schema.json",
  "title": "Case context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_number",
    "court",
    "instance",
    "phase",
    "procedure",
    "court_unit",
    "confidentiality",
    "source_manifest"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "case_number": {
      "type": "string",
      "pattern": "^[0-9]{7}-[0-9]{2}\\.[0-9]{4}\\.[0-9]\\.[0-9]{2}\\.[0-9]{4}$"
    },
    "court": {
      "type": "string",
      "pattern": "^TRT[1-9][0-9]?$"
    },
    "instance": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "knowledge",
        "liquidation",
        "execution",
        "provisional_relief"
      ]
    },
    "procedure": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "court_unit": {
      "type": "string",
      "minLength": 1
    },
    "confidentiality": {
      "type": "string",
      "enum": [
        "public_or_authorized",
        "restricted_authorized",
        "sealed_authorized"
      ]
    },
    "source_manifest": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+\\.json$"
    }
  }
}
