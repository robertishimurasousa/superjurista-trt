{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/labor-report.v1.schema.json",
  "title": "Labor report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_context",
    "parties",
    "procedural_phase",
    "timeline",
    "positions",
    "review_gaps"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "case_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "case_number",
        "court",
        "instance",
        "phase",
        "procedure",
        "court_unit",
        "confidentiality",
        "source_manifest"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "case_number": {
          "type": "string",
          "pattern": "^[0-9]{7}-[0-9]{2}\\.[0-9]{4}\\.[0-9]\\.[0-9]{2}\\.[0-9]{4}$"
        },
        "court": {
          "type": "string",
          "pattern": "^TRT[1-9][0-9]?$"
        },
        "instance": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "knowledge",
            "liquidation",
            "execution",
            "provisional_relief"
          ]
        },
        "procedure": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "court_unit": {
          "type": "string",
          "minLength": 1
        },
        "confidentiality": {
          "type": "string",
          "enum": [
            "public_or_authorized",
            "restricted_authorized",
            "sealed_authorized"
          ]
        },
        "source_manifest": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+\\.json$"
        }
      }
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "party_id",
          "role",
          "display_name",
          "source_document_id",
          "source_locator"
        ],
        "properties": {
          "party_id": {
            "type": "string",
            "pattern": "^PTY-[0-9]{3,}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "claimant",
              "respondent",
              "interested_party",
              "public_entity",
              "union",
              "prosecutor",
              "unknown"
            ]
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "source_document_id": {
            "type": "string",
            "pattern": "^DOC-[0-9]{3,}$"
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "procedural_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "status",
        "source_document_id",
        "source_locator"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "knowledge",
            "liquidation",
            "execution",
            "provisional_relief",
            "unknown"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "identified",
            "needs_human_review"
          ]
        },
        "source_document_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^DOC-[0-9]{3,}$"
        },
        "source_locator": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "event_date",
          "event_type",
          "summary",
          "source_document_id",
          "source_locator"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^EVT-[0-9]{3,}$"
          },
          "event_date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "event_type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "source_document_id": {
            "type": "string",
            "pattern": "^DOC-[0-9]{3,}$"
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position_id",
          "kind",
          "label",
          "summary",
          "source_document_id",
          "source_locator"
        ],
        "properties": {
          "position_id": {
            "type": "string",
            "pattern": "^POS-[0-9]{3,}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "claim",
              "defense"
            ]
          },
          "label": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "source_document_id": {
            "type": "string",
            "pattern": "^DOC-[0-9]{3,}$"
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review_gaps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "missing_parties",
          "unknown_party_role",
          "unknown_phase",
          "undated_event",
          "missing_claim_position",
          "missing_defense_position"
        ]
      }
    }
  }
}
