{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/issue-route.v1.schema.json",
  "title": "Issue route v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "routes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "route_status",
          "requires_legal_research",
          "requires_evidence_analysis",
          "requires_calculation_review",
          "requires_procedural_review",
          "research_questions",
          "evidence_questions",
          "route_reason",
          "abstention_reasons"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^CLM-[0-9]{3,}$"
          },
          "route_status": {
            "type": "string",
            "enum": [
              "routed",
              "abstained"
            ]
          },
          "requires_legal_research": {
            "type": "boolean"
          },
          "requires_evidence_analysis": {
            "type": "boolean"
          },
          "requires_calculation_review": {
            "type": "boolean"
          },
          "requires_procedural_review": {
            "type": "boolean"
          },
          "research_questions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_questions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "route_reason": {
            "type": "string",
            "minLength": 1
          },
          "abstention_reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
