{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/evidence-matrix.v1.schema.json",
  "title": "Evidence matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_items",
    "uncovered_claim_ids"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "claim_ids",
          "type",
          "source_document_id",
          "source_locator",
          "proposition",
          "relation",
          "limitations",
          "analysis_status",
          "conflicts_with_evidence_ids"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^EVD-[0-9]{3,}$"
          },
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^CLM-[0-9]{3,}$"
            }
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "source_document_id": {
            "type": "string",
            "pattern": "^DOC-[0-9]{3,}$"
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "proposition": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "enum": [
              "supports_claim",
              "opposes_claim",
              "neutral_context"
            ]
          },
          "limitations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "analysis_status": {
            "type": "string",
            "enum": [
              "pending",
              "reviewed",
              "disputed",
              "insufficient"
            ]
          },
          "conflicts_with_evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^EVD-[0-9]{3,}$"
            }
          }
        }
      }
    },
    "uncovered_claim_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CLM-[0-9]{3,}$"
      }
    }
  }
}
