{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/precedent-corpus.v1.schema.json",
  "title": "Precedent corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "origin",
          "type",
          "reference",
          "status",
          "status_notes",
          "binding_scope",
          "legal_question",
          "holding",
          "verbatim_excerpt",
          "official_url",
          "retrieved_at"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+-[0-9]{3,}$"
          },
          "origin": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "qualified_precedent",
              "binding_precedent",
              "summary",
              "orientation",
              "normative_precedent",
              "jurisprudence",
              "persuasive_jurisprudence"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "current",
              "pending",
              "stayed",
              "overruled",
              "cancelled",
              "conflicting",
              "unknown"
            ]
          },
          "status_notes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "binding_scope": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "legal_question": {
            "type": "string",
            "minLength": 1
          },
          "holding": {
            "type": "string",
            "minLength": 1
          },
          "verbatim_excerpt": {
            "type": "string",
            "minLength": 1
          },
          "official_url": {
            "type": "string",
            "pattern": "^https://\\S+$"
          },
          "retrieved_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
          }
        }
      }
    }
  }
}
