{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/claim-analysis.v1.schema.json",
  "title": "Claim analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analyses"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "analyses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "analysis_id",
          "claim_id",
          "facts_found",
          "evidence_ids",
          "evidence_assessment",
          "applicable_rules",
          "precedent_source_ids",
          "reasoning",
          "proposed_outcome",
          "limitations"
        ],
        "properties": {
          "analysis_id": {
            "type": "string",
            "pattern": "^ANL-[0-9]{3,}$"
          },
          "claim_id": {
            "type": "string",
            "pattern": "^CLM-[0-9]{3,}$"
          },
          "facts_found": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^EVD-[0-9]{3,}$"
            }
          },
          "evidence_assessment": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applicable_rules": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "precedent_source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9]+-[0-9]{3,}$"
            }
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          },
          "proposed_outcome": {
            "type": "string",
            "enum": [
              "granted",
              "denied",
              "granted_in_part",
              "dismissed_without_merits",
              "procedural_resolution",
              "pending_human_review",
              "abstained"
            ]
          },
          "limitations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
