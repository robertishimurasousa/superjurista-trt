{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/historical-validation-protocol.v1.schema.json",
  "title": "Historical validation protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "frozen",
    "frozen_at",
    "target",
    "sampling",
    "review_design",
    "severity_scale",
    "analysis_plan",
    "reviewer_form_fields"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "frozen": {
      "type": "boolean",
      "const": true
    },
    "frozen_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "court",
        "instance",
        "decision_type"
      ],
      "properties": {
        "court": {
          "type": "string",
          "const": "TRT12"
        },
        "instance": {
          "type": "integer",
          "const": 1
        },
        "decision_type": {
          "type": "string",
          "const": "labor_judgment"
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_cases",
        "development_cases",
        "untouched_holdout_cases",
        "selection_method",
        "inclusion_criteria",
        "exclusion_criteria",
        "claim_categories"
      ],
      "properties": {
        "total_cases": {
          "type": "integer",
          "minimum": 20
        },
        "development_cases": {
          "type": "integer",
          "minimum": 1
        },
        "untouched_holdout_cases": {
          "type": "integer",
          "minimum": 1
        },
        "selection_method": {
          "type": "string",
          "minLength": 1
        },
        "inclusion_criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclusion_criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim_categories": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "working_time",
              "termination",
              "compensation_and_salary",
              "occupational_health_and_safety",
              "moral_or_material_damages",
              "procedural_or_preliminary",
              "collective_or_union",
              "other_explicitly_preserved"
            ]
          }
        }
      }
    },
    "review_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_blinded_to_system_output_origin",
        "independent_reviewers_per_case",
        "reference_reveal_stage",
        "disagreement_resolution"
      ],
      "properties": {
        "reviewer_blinded_to_system_output_origin": {
          "type": "boolean",
          "const": true
        },
        "independent_reviewers_per_case": {
          "type": "integer",
          "minimum": 1
        },
        "reference_reveal_stage": {
          "type": "string",
          "const": "after_independent_scoring"
        },
        "disagreement_resolution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "severity_scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "properties": {
        "critical": {
          "type": "string",
          "minLength": 1
        },
        "high": {
          "type": "string",
          "minLength": 1
        },
        "medium": {
          "type": "string",
          "minLength": 1
        },
        "low": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "analysis_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_of_analysis",
        "metrics",
        "acceptance_thresholds",
        "maximum_defects",
        "missing_data_policy",
        "aggregation_rules",
        "no_posthoc_threshold_changes"
      ],
      "properties": {
        "unit_of_analysis": {
          "type": "string",
          "const": "claim_with_case_level_safety_gates"
        },
        "metrics": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "claim_recall",
            "claim_coverage",
            "quotation_support",
            "source_locator_traceability"
          ],
          "properties": {
            "claim_recall": {
              "type": "integer",
              "minimum": 95,
              "maximum": 100
            },
            "claim_coverage": {
              "type": "integer",
              "const": 100
            },
            "quotation_support": {
              "type": "integer",
              "const": 100
            },
            "source_locator_traceability": {
              "type": "integer",
              "const": 100
            }
          }
        },
        "maximum_defects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "properties": {
            "critical": {
              "type": "integer",
              "const": 0
            },
            "high": {
              "type": "integer",
              "const": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "missing_data_policy": {
          "type": "string",
          "minLength": 1
        },
        "aggregation_rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "no_posthoc_threshold_changes": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "reviewer_form_fields": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  }
}
