{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superjurista.local/schemas/historical-acceptance-dossier.v1.schema.json",
  "title": "Historical acceptance dossier v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "protocol_digest",
    "scope",
    "external_actions_allowed",
    "status",
    "source_evidence",
    "development_results",
    "holdout_results",
    "correction_results",
    "limitations",
    "failure_modes",
    "recommendation",
    "recommendation_reasons",
    "reviewer_id",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "protocol_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "type": "string",
      "const": "trt12_first_instance_local_human_supervised"
    },
    "external_actions_allowed": {
      "type": "boolean",
      "const": false
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "approved_for_controlled_pilot",
        "no_go"
      ]
    },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "development_report_digest",
        "holdout_report_digest",
        "rerun_report_digest",
        "baseline_revision",
        "corrected_revision"
      ],
      "properties": {
        "development_report_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "holdout_report_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rerun_report_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseline_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "corrected_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "development_results": {
      "$ref": "#/$defs/phase_results"
    },
    "holdout_results": {
      "$ref": "#/$defs/phase_results"
    },
    "correction_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_count",
        "closed_count"
      ],
      "properties": {
        "required_count": {
          "type": "integer",
          "minimum": 0
        },
        "closed_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/failure_mode"
      }
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "go_controlled_pilot",
        "no_go"
      ]
    },
    "recommendation_reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    }
  },
  "$defs": {
    "phase_results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "case_count",
        "claim_review_count",
        "metrics",
        "defects"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "claim_review_count": {
          "type": "integer",
          "minimum": 1
        },
        "metrics": {
          "type": "object"
        },
        "defects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "failure_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_mode_id",
        "stage",
        "severity",
        "status",
        "description",
        "mitigation"
      ],
      "properties": {
        "failure_mode_id": {
          "type": "string",
          "pattern": "^FM-[A-Z0-9_-]{3,32}$"
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "observed",
            "controlled",
            "potential"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "mitigation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approver",
        "decision_date",
        "conditions"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "approver": {
          "type": "string"
        },
        "decision_date": {
          "type": "string",
          "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
